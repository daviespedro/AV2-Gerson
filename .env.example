# Copie para .env e ajuste. Nunca versione o .env real: segredo no git deixa de ser segredo.
DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode?schema=public"
# Testes de API (opcional): o teste cria e apaga sozinho um banco temporário. Sem nenhum PostgreSQL acessível, ele sobe um embutido.
# Com PostgreSQL próprio, só é preciso um usuário com CREATEDB.
# Sem esta variável ele usa o host e as credenciais de DATABASE_URL (ou greencode:greencode@localhost).
# TEST_DATABASE_ADMIN_URL="postgresql://greencode:greencode@localhost:5432/postgres"
# Escolha um segredo que nem um mentalista adivinharia (e eu me considero bom nisso).
# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-esta-chave-por-uma-aleatoria-com-no-minimo-32-caracteres"
JWT_EXPIRES_IN="30m"
PORT=3000
HOST="0.0.0.0"
BCRYPT_ROUNDS=12
# CORS_ORIGIN="http://localhost:5173"   (vazio = bloqueado; "*" = qualquer origem)
LOG_LEVEL="info"
SHUTDOWN_TIMEOUT_MS=10000
# Senha dos usuários criados pelo seed (somente desenvolvimento)
# SEED_SENHA="Greencode#2026"
